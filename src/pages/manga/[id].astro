---
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar";
import MangaDetail from "../../components/manga/MangaDetail";
import { mangas } from "../../data/mangas";

export function getStaticPaths() {
    return mangas.map((manga) => ({ params: { id: manga.id }, props: { manga } }));
}

const { manga } = Astro.props;
---

<Base title={`Manga Plus | ${manga.title}`} description={manga.description}>
    <Navbar current="inicio" client:load />
    <main class="mx-auto max-w-6xl px-4 py-8">
        <MangaDetail id={manga.id} client:only="react" />
    </main>
</Base>
