---
import Base from "../../../layouts/Base.astro";
import Reader from "../../../components/reader/Reader";
import { chapterPages } from "../../../data/chapter-pages";
import { isReadable, mangas } from "../../../data/mangas";

export function getStaticPaths() {
    return mangas
        .filter(isReadable)
        .flatMap((manga) =>
            Array.from({ length: manga.chapters }, (_, i) => ({
                params: { id: manga.id, cap: String(i + 1) },
                props: { manga, chapter: i + 1 },
            })),
        );
}

const { manga, chapter } = Astro.props;
const pages = chapterPages(manga.id, chapter);
---

<Base title={`Leer | ${manga.title} - Capítulo ${chapter}`}>
    <Reader id={manga.id} chapter={chapter} pages={pages} client:only="react" />
</Base>
