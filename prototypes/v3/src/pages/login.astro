---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CoverGallery from "../components/login/CoverGallery.astro";
import LoginForm from "../components/login/LoginForm";
import StatusLegend from "../components/login/StatusLegend";
import { getBrand } from "../lib/images";

const logo = getBrand("logo-manga-plus");
---

<Base title="Manga Plus | Login" description="Inicia sesión en Manga Plus para leer y seguir tus mangas favoritos.">
    <main class="grid min-h-screen grid-cols-1 md:grid-cols-2">
        <CoverGallery />

        <section class="order-first flex flex-col justify-center gap-4 bg-panel px-[clamp(1.5rem,5vw,4rem)] py-12 md:order-none">
            {
                logo ? (
                    <Image src={logo} alt="Manga Plus by Shueisha" class="h-auto max-w-[200px] self-end" />
                ) : (
                    <p class="self-end text-2xl font-bold text-accent">MANGA PLUS</p>
                )
            }

            <h1 class="text-4xl font-bold">Bienvenido</h1>
            <p class="text-muted">
                Lee, guarda y sigue tus mangas. Antes de abrir un título, siempre verás si está disponible.
            </p>

            <LoginForm client:load />
            <StatusLegend />
        </section>
    </main>
</Base>
