---
import { url } from "../lib/paths";
import { Image } from "astro:assets";
import type { Manga } from "../data/mangas";
import { getCover } from "../lib/images";
import StatusBadge from "./StatusBadge";

interface Props {
    manga: Manga;
}

const { manga } = Astro.props;
const cover = getCover(manga.cover);
---

<a
    href={url(`/manga/${manga.id}`)}
    class="group block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
>
    <div class="relative aspect-[2/3] overflow-hidden rounded-lg bg-surface">
        {
            cover ? (
                <Image
                    src={cover}
                    alt={`Portada de ${manga.title}`}
                    widths={[240, 480]}
                    sizes="(min-width: 768px) 20vw, 50vw"
                    loading="lazy"
                    class="size-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-105"
                />
            ) : (
                <div class="grid size-full place-items-center p-2 text-center text-sm font-semibold">{manga.title}</div>
            )
        }
        <div class="absolute inset-x-0 top-2 flex justify-center">
            <span class="rounded-full bg-base/80 backdrop-blur">
                <StatusBadge status={manga.status} />
            </span>
        </div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 translate-y-full overflow-y-auto bg-base/90 p-2 text-xs text-white opacity-0 backdrop-blur transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100 flex items-start">
            <p>{manga.description}</p>
        </div>
    </div>
    <h3 class="mt-2 text-sm font-semibold">{manga.title}</h3>
    <p class="text-xs text-muted">{manga.chapters} capítulos · ★ {manga.rating}</p>
</a>
