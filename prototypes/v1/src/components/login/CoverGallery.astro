---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCover } from "../../lib/images";

const names = [
    { file: "dragon-ball", title: "Dragon Ball Super" },
    { file: "one-punch-man", title: "One Punch Man" },
    { file: "spy-family", title: "Spy x Family" },
    { file: "saiko", title: "Saiko One-Shots" },
    { file: "naruto", title: "Naruto" },
    { file: "tokyo-ghoul", title: "Tokyo Ghoul" },
];

const covers = names
    .map((cover) => ({ title: cover.title, image: getCover(cover.file) }))
    .filter((cover): cover is { title: string; image: ImageMetadata } => cover.image !== undefined);
---

<section class="bg-dots p-8" aria-label="Mangas destacados">
    <ul class="grid grid-cols-3 gap-4">
        {
            covers.map((cover) => (
                <li class="aspect-[2/3] overflow-hidden rounded-sm bg-surface">
                    <Image
                        src={cover.image}
                        alt={`Portada de ${cover.title}`}
                        widths={[240, 480]}
                        sizes="(min-width: 768px) 20vw, 33vw"
                        loading="lazy"
                        class="size-full object-cover"
                    />
                </li>
            ))
        }
    </ul>
</section>
